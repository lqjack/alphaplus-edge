{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlphaPlus Edge",
  "version": "0.1.0",
  "identifier": "com.alphaplus.edge",
  "build": {
    "beforeDevCommand": "python3 -m http.server 1420 --directory ui",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "AlphaPlus Edge",
        "width": 640,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "10.15"
    }
  }
}
