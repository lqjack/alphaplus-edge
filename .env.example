# AlphaPlus Edge — local environment template
# Copy: cp .env.example .env.edge && source .env.edge

# ── Identity ──────────────────────────────────────────────────────────
EDGE_ID=local-edge
EDGE_DEVICE_TOKEN=change-me-after-register

# ── Cloud Gateway (Neura Gateway API — Edge register / WSS) ─────────
CLOUD_GATEWAY_URL=https://alphaplus-api.datapro.asia
GATEWAY_URL=${CLOUD_GATEWAY_URL}
GATEWAY_PUBLIC_URL=https://alphaplus-api.datapro.asia
# NeuraDesk console (optional): https://gateway.datapro.asia — NOT the Edge API

# ── Local Edge Agent ──────────────────────────────────────────────────
EDGE_HEALTH_HOST=127.0.0.1
EDGE_HEALTH_PORT=10490
EDGE_CALLBACK_BASE_URL=http://127.0.0.1:10490
EDGE_START_TUNNEL=true

# ── OpenCLI / wx-cli (optional, for XHS / WeChat tools) ───────────────
OPENCLI_BIN=opencli
OPENCLI_BROWSER_SESSION=dataproai
WX_CLI_BIN=wx

# ── Edge MCP services (comma-separated) ───────────────────────────────
EDGE_MCP_SERVICES=xiaohongshu,wx_cli,opencli_weixin,wechat_viewer
EDGE_SERVICES=xiaohongshu,wx_cli,opencli_weixin,wechat_viewer

# ── Security / production ───────────────────────────────────────────
# EDGE_TUNNEL_INSECURE_SKIP_VERIFY=0   # dev only
# EDGE_TOKEN_GRACE_SECONDS=3600
# EDGE_ADMIN_KEY=                      # ops forced token rotation

# ── Monorepo path (dev sync only) ─────────────────────────────────────
# ALPHAPLUS_MONOREPO=../dataproaiset
